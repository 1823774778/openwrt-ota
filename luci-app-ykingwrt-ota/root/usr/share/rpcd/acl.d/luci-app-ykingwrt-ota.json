{
  "luci-app-ykingwrt-ota": {
    "description": "YkingWrt release-based firmware updates",
    "read": {
      "ubus": {
        "file": ["exec"]
      },
      "file": {
        "/usr/libexec/ykingwrt-ota status": ["exec"]
      }
    },
    "write": {
      "ubus": {
        "file": ["exec"]
      },
      "file": {
        "/usr/libexec/ykingwrt-ota check": ["exec"],
        "/usr/libexec/ykingwrt-ota download": ["exec"],
        "/usr/libexec/ykingwrt-ota clean": ["exec"],
        "/usr/libexec/ykingwrt-ota set-proxy": ["exec"],
        "/usr/libexec/ykingwrt-ota set-proxy *": ["exec"],
        "/usr/libexec/ykingwrt-ota upgrade 0 *": ["exec"],
        "/usr/libexec/ykingwrt-ota upgrade 1 *": ["exec"]
      }
    }
  }
}
